# --- Claude (https://platform.claude.com -> API keys) ---
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low

# --- Meta (Instagram + Facebook Messenger) ---
# Token d'accès de la PAGE Facebook reliée au compte Instagram @ixeam_01
PAGE_ACCESS_TOKEN=
# App Dashboard -> Paramètres -> Base -> Clé secrète
META_APP_SECRET=
# Un mot de passe que VOUS inventez, à recopier dans la config du webhook Meta
META_VERIFY_TOKEN=ixeam-change-moi
GRAPH_API_VERSION=v24.0

# --- Comportement ---
DEBOUNCE_SECONDS=4
HANDOFF_PAUSE_HOURS=12
HUMAN_REPLY_PAUSE_HOURS=12
HISTORY_LIMIT=30
DB_PATH=ixeam_agent.db

# --- Admin (pour voir les leads : GET /admin/leads) ---
ADMIN_TOKEN=change-moi-aussi

# --- Optionnel : notification Telegram quand un client doit être repris par un humain ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
