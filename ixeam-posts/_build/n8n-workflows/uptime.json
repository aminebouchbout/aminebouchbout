{
  "name": "Store uptime monitor",
  "nodes": [
    {
      "id": "n0101-0000-4000-8000-000000000000",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "n0102-0000-4000-8000-000000000000",
      "name": "Check the store",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "url": "https://your-store.com",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 10000
        }
      }
    },
    {
      "id": "n0103-0000-4000-8000-000000000000",
      "name": "Store is down?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n0104-0000-4000-8000-000000000000",
      "name": "Alert on Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        740,
        -100
      ],
      "parameters": {
        "chatId": "123456789",
        "text": "=⚠️ الـ Store ما راهوش يجاوب — Status: {{ $json.statusCode }}",
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram bot"
        }
      }
    },
    {
      "id": "n0105-0000-4000-8000-000000000000",
      "name": "All good",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        740,
        100
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Check the store",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check the store": {
      "main": [
        [
          {
            "node": "Store is down?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Store is down?": {
      "main": [
        [
          {
            "node": "Alert on Telegram",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "All good",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {
    "Check the store": [
      {
        "json": {
          "statusCode": 200,
          "statusMessage": "OK"
        }
      }
    ]
  },
  "settings": {
    "executionOrder": "v1"
  }
}