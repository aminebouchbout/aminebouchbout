{
  "name": "AI Agent — Store support",
  "nodes": [
    {
      "id": "n0001-0000-4000-8000-000000000000",
      "name": "Instagram / Messenger DM",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "ig-dm",
        "options": {}
      }
    },
    {
      "id": "n0002-0000-4000-8000-000000000000",
      "name": "AI Agent — Store support",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "options": {
          "systemMessage": "You are the support agent of the store. Use the tools to read real order and stock data. Never invent information. Any refund or price change must be approved by the owner."
        }
      }
    },
    {
      "id": "n0003-0000-4000-8000-000000000000",
      "name": "Claude (Chat Model)",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        180,
        260
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-sonnet-4-5"
        },
        "options": {}
      },
      "credentials": {
        "anthropicApi": {
          "id": "",
          "name": "Anthropic account"
        }
      }
    },
    {
      "id": "n0004-0000-4000-8000-000000000000",
      "name": "Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        340,
        260
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $json.body.sender_id }}"
      }
    },
    {
      "id": "n0005-0000-4000-8000-000000000000",
      "name": "Get order (Shopify)",
      "type": "n8n-nodes-base.shopifyTool",
      "typeVersion": 1,
      "position": [
        500,
        260
      ],
      "parameters": {
        "authentication": "accessToken",
        "operation": "get",
        "orderId": "={{ $fromAI('order_id', 'The order number') }}",
        "options": {}
      },
      "credentials": {
        "shopifyAccessTokenApi": {
          "id": "",
          "name": "Shopify — my store"
        }
      }
    },
    {
      "id": "n0006-0000-4000-8000-000000000000",
      "name": "Check stock (Shopify)",
      "type": "n8n-nodes-base.shopifyTool",
      "typeVersion": 1,
      "position": [
        660,
        260
      ],
      "parameters": {
        "authentication": "accessToken",
        "resource": "product",
        "operation": "get",
        "productId": "={{ $fromAI('product_id', 'The product id') }}",
        "additionalFields": {}
      },
      "credentials": {
        "shopifyAccessTokenApi": {
          "id": "",
          "name": "Shopify — my store"
        }
      }
    },
    {
      "id": "n0007-0000-4000-8000-000000000000",
      "name": "Reply to customer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v21.0/me/messages",
        "options": {}
      }
    }
  ],
  "connections": {
    "Instagram / Messenger DM": {
      "main": [
        [
          {
            "node": "AI Agent — Store support",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claude (Chat Model)": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent — Store support",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent — Store support",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    },
    "Get order (Shopify)": {
      "ai_tool": [
        [
          {
            "node": "AI Agent — Store support",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "Check stock (Shopify)": {
      "ai_tool": [
        [
          {
            "node": "AI Agent — Store support",
            "type": "ai_tool",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent — Store support": {
      "main": [
        [
          {
            "node": "Reply to customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {
    "Instagram / Messenger DM": [
      {
        "json": {
          "body": {
